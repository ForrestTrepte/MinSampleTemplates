{
    "name": "Google Gemini GenAI MinSampleTemplate",
    "build": {
        "dockerfile": "../Dockerfile",
        "context": ".."
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/opt/venvs/google-gemini-genai/bin/python"
            }
        }
    },
    "workspaceFolder": "/workspaces/MinSampleTemplates/google_gemini_genai"
}
